# Порт сервера
PORT=3000

# Окружение (development / production)
NODE_ENV=production

# Секретный ключ JWT для подписи токенов авторизации (сгенерируйте надёжный ключ, например: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h

# Параметры подключения к базе данных MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=karate_club
DB_USER=karate_app
DB_PASSWORD=your_strong_database_password_here
DB_SSL=false

# Настройки YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# Учётные данные администратора по умолчанию (для первого запуска)
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=change_this_admin_password_immediately
